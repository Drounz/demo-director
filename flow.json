{
  "name": "prospector-demo",
  "baseUrl": "https://YOUR-PROSPECTOR-URL",
  "storageState": "auth.json",
  "headless": false,
  "viewport": { "width": 1280, "height": 720 },
  "outDir": "out",
  "defaults": { "moveMs": 900, "typeDelay": 55, "pauseMs": 800 },

  "_comment": "Replace every selector below with a real one from your app. Prefer data-testid, eg [data-testid='new-lead']. Text selectors like text=New lead also work. This is the single-lead spine: intake, enrichment, grading, result.",

  "steps": [
    { "action": "goto", "url": "/leads" },
    { "action": "caption", "text": "This is Prospector, our lead grading engine.", "ms": 2600 },

    { "action": "caption", "text": "We start by dropping in a new lead.", "ms": 2200 },
    { "action": "click", "selector": "[data-testid='new-lead']" },
    { "action": "type", "selector": "[data-testid='company-name']", "text": "Acme Distribution Ltd" },
    { "action": "type", "selector": "[data-testid='company-website']", "text": "acme-dist.com" },
    { "action": "click", "selector": "[data-testid='submit-lead']" },

    { "action": "caption", "text": "Enrichment runs as a cost-ordered waterfall.", "ms": 2600 },
    { "action": "wait", "selector": "[data-testid='status-enriched']", "timeout": 30000 },
    { "action": "highlight", "selector": "[data-testid='status-enriched']", "ms": 1800 },

    { "action": "caption", "text": "Then grading assigns an A, B, C or F.", "ms": 2400 },
    { "action": "wait", "selector": "[data-testid='grade-badge']", "timeout": 30000 },
    { "action": "highlight", "selector": "[data-testid='grade-badge']", "ms": 2000, "keep": true },

    { "action": "caption", "text": "Routing splits on segment, vertical, merchant type and market.", "ms": 3000 },
    { "action": "scrollTo", "selector": "[data-testid='routing-panel']" },
    { "action": "highlight", "selector": "[data-testid='routing-panel']", "ms": 2200 },

    { "action": "caption", "text": "Graded, routed, ready for review.", "ms": 2400 }
  ]
}
